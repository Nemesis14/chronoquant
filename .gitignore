__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.env
.env.*

# =============================================================================
# Local databases and generated data
# =============================================================================
data/
/database/
*.db
*.sqlite
*.sqlite3
*.parquet
