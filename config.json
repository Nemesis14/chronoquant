{
    "database": {
        "db_path": "D:/repos/chronoquant/data/bchusdt_data.db",
        "symbol": "BCHUSDT",
        "interval": "1m",
        "tables": {
            "ohlcv": "bchusdt_1m",
            "features": "bchusdt_1m_features",
            "predictions": "bchusdt_1m_predictions"
        },
        "features": {
            "rolling_window": 240,
            "target_percentile": 0.9,
            "indicators": {
                "momentum": {
                    "rsi": [
                        {"window": 14}
                    ],
                    "roc": [
                        {"window": 14},
                        {"window": 140}
                    ]
                },
                "trend": {
                    "macd": [
                        {"fast": 12, "slow": 26}
                    ],
                    "sma": [
                        {"window": 14},
                        {"window": 140}
                    ]
                },
                "volatility": {
                    "bollinger": [
                        {"window": 14},
                        {"window": 140}
                    ]
                }
            }
        }
    },
    "model": {
        "type": "logreg",
        "model_dir": "model_dev/logreg_base",
        "model_file": "model.pkl",
        "features_file": "features.json"
    },
    "api": {
        "binance_keys_path": "C:/connection/binance_keys.json"
    }
}