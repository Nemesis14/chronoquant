        "level_tolerance_atr": 0.25,
        "level_min_touches": 2,
        "strength_tau_frac": 0.3333333333,
        "round_step": 10.0,
        "round_step_secondary": 5.0,
        "line_tolerance_atr": 0.25,
        "line_min_touches": 3,
        "line_dedup_slope_atr": 0.1,
        "break_atr": 0.5,
        "retest_bars": 12,
        "forward_bars": 24,
        "forward_move_atr": 1.0,
        "scales": {
            "s": {"bar": "1h", "lookback_days": 7},
            "m": {"bar": "4h", "lookback_days": 30},
            "l": {"bar": "1d", "lookback_days": 180}
        }
    },
    "feature_taxonomy": {
        "_comment": "t-1 live consistency taxonomy (KAN-25 audit). All OHLCV-based features are globally shifted by 1 bar in sync_features.py so the stored value at row t uses only data from bar t-1.",
